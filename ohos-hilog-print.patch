+#include "hilog-helper.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "hilog/log_c.h"
+#include "string.h"
+
+static void maskSerialNumber(char *message)
+{
+    static const char serialDelims[] = "&\"') \n";
+    char *search = message;
+    char *pos;
+
+    while ((pos = strstr(search, "serial=")) != NULL) {
+        char *value = pos + sizeof("serial=") - 1;
+        size_t valueLen = strcspn(value, serialDelims);
+        size_t maskedLen = valueLen < 3 ? valueLen : 3;
+
+        if (valueLen > maskedLen) {
+            char *tail = value + valueLen;
+            memmove(value + maskedLen, tail, strlen(tail) + 1);
+        }
+        memset(value, '*', maskedLen);
+        search = value + maskedLen;
+    }
+}
+
+void hilogPrint(int level, const char *message)
+{
+    if (strstr(message, "auth-info") || strstr(message, "password")) {
+        return;
+    }
+    if (!strstr(message, "serial=")) {
+        HiLogPrint(LOG_CORE, LOG_DEBUG, 0xD0050B0, "cupslog", "%{public}s", message);
+        return;
+    }
+    size_t len = strlen(message);
+    char *buf = (char *)malloc(len + 1);
+    if (!buf) {
+        return;
+    }
+    memcpy(buf, message, len + 1);
+    maskSerialNumber(buf);
+    HiLogPrint(LOG_CORE, LOG_DEBUG, 0xD0050B0, "cupslog", "%{public}s", buf);
+    free(buf);
+}
